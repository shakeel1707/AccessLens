# Environment: dev, test, prod
ENVIRONMENT=dev

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Scanning
SCAN_TIMEOUT_SECONDS=30
MAX_CONCURRENT_SCANS=5

# Repair Generation
REPAIR_TIMEOUT_SECONDS=20
MAX_REPAIRS_PER_SCAN=10

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB (local development)
USE_LOCAL_DYNAMODB=true
LOCAL_DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_SCANS=accesslens-scans
DYNAMODB_TABLE_FINDINGS=accesslens-findings
DYNAMODB_TABLE_REPAIRS=accesslens-repairs
DYNAMODB_TABLE_VERIFICATION=accesslens-verification

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# CloudWatch (optional)
ENABLE_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/accesslens/backend